    python3-pip \
    python3-setuptools \
    python3-rosdep2 \
    python3-vcstools \
    python3-empy \
    python3-nose \
    python3-pycryptodome \
    python3-pyqt5.qtsvg \
    python3-pyqt5 \
    python3-sip \
    python3-sip-dev \
    pyqt5-dev \
    python3-defusedxml \
    python3-mock \
    python3-netifaces \
    python3-gnupg \
    python3-numpy \
